include ReelSyntax_Skills/CATALOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md
include LICENSE README.md CHANGELOG.md SECURITY.md pyproject.toml uv.lock
recursive-include locales *.json
recursive-include lang-profiles *.json
recursive-include reelsyntax/data *.json *.md *.html *.css *.js
recursive-include docs *.md *.json
recursive-include examples *.md *.json *.py
recursive-include tests *.py
recursive-include ReelSyntax_Skills/tests *.py *.json
recursive-include ReelSyntax_Skills/examples *.py *.md *.json
global-exclude .DS_Store *.py[cod]
prune .venv
prune .tools
prune build
prune integrations
prune examples/*/.reelsyntax
prune examples/*/output
prune examples/*/review
