{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remirdy.github.io/ReelSyntax/schemas/config.v1.schema.json",
  "title": "ReelSyntax configuration",
  "type": "object",
  "properties": {
    "config_version": {
      "const": 1
    },
    "general": {
      "type": "object",
      "properties": {
        "ui_lang": {
          "type": "string",
          "anyOf": [
            {
              "const": "auto"
            },
            {
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            }
          ]
        },
        "video_lang": {
          "type": "string",
          "anyOf": [
            {
              "const": "auto"
            },
            {
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            }
          ]
        },
        "allow_network": {
          "type": "boolean"
        },
        "attribution": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "mcp_host",
            "offline_rules",
            "ollama",
            "openai_compat"
          ]
        },
        "model": {
          "type": "string",
          "maxLength": 128
        },
        "endpoint": {
          "type": "string",
          "maxLength": 512
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max_repairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "ffmpeg": {
          "type": "string"
        },
        "ffprobe": {
          "type": "string"
        },
        "blender": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "properties": {
        "default_profile": {
          "enum": [
            "draft",
            "hero",
            "production"
          ]
        },
        "cache_budget_mib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "generative": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "maxLength": 512
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "spdx": {
          "enum": [
            "Apache-2.0",
            "BSD-2-Clause",
            "BSD-3-Clause",
            "CC-BY-4.0",
            "CC0-1.0",
            "ISC",
            "MIT",
            "OFL-1.1",
            "User-Provided"
          ]
        },
        "attribution": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false
}
