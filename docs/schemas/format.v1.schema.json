{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remirdy.github.io/ReelSyntax/schemas/format.v1.schema.json",
  "title": "ReelSyntax format manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "category",
    "aspect",
    "duration_sec",
    "languages",
    "engines",
    "needs",
    "steps",
    "qc_rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "object",
      "required": [
        "en",
        "tr",
        "de"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "category": {
      "enum": [
        "art",
        "business",
        "comedy",
        "creator",
        "education",
        "music",
        "personal",
        "social"
      ]
    },
    "aspect": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "16:9",
          "1:1",
          "4:5",
          "9:16"
        ]
      }
    },
    "duration_sec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 16
      }
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "blender",
          "browser",
          "chromium",
          "ffmpeg",
          "pillow",
          "webgl"
        ]
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "optional": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "enum": [
              "llm",
              "qc",
              "render"
            ]
          },
          "gate": {
            "const": "approve"
          },
          "profile": {
            "enum": [
              "draft",
              "hero",
              "production",
              "snapshot"
            ]
          },
          "scope": {
            "enum": [
              "first_5s",
              "full"
            ]
          }
        }
      }
    },
    "qc_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  }
}
